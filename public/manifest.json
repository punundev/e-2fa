{
  "manifest_version": 3,
  "name": "SynergyKH — 2FA",
  "version": "1.0.22",
  "description": "Secure, local, offline 2FA authenticator supporting TOTP, HOTP, encrypted backups, and Google Authenticator migration.",
  "icons": {
    "16": "icons/logo.png",
    "32": "icons/logo.png",
    "48": "icons/logo.png",
    "128": "icons/logo.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SecureAuth 2FA Authenticator",
    "default_icon": {
      "16": "icons/logo.png",
      "32": "icons/logo.png",
      "48": "icons/logo.png",
      "128": "icons/logo.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "optional_permissions": [
    "permissions"
  ],
  "host_permissions": [
    "https://2fa.synergykh.site/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
