# SecureAuth Environment Configuration Example

# Server Environment
NODE_ENV=development
PORT=5000

# Database Connection (Standard PostgreSQL or Neon Serverless)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
PGSSLMODE=require

# Authentication & Session Security
AUTH_PROVIDER=self-hosted-neon
JWT_SECRET=replace-with-a-cryptographically-secure-random-string-at-least-32-chars

# API & Extension Configuration
API_BASE_URL=http://localhost:5000
APP_URL=http://localhost:5000

# CORS Allowed Origins (Comma-separated for extensions & frontend clients)
# Use chrome-extension://<EXTENSION_ID> in production
CORS_ALLOWED_ORIGINS=*

# Rate Limiting & Payload Limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=30
MAX_VAULT_PAYLOAD_BYTES=5242880

# Logging
LOG_LEVEL=info
